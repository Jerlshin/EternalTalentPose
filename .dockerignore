# Mirrors .gitignore — the Docker build context should match what HF Spaces
# actually receives from `git clone` of the Space repo, not local dev cruft.

.git/
.claude/
CLAUDE.md

__pycache__/
*.py[cod]
*$py.class
*.so

.venv/
venv/
env/
ENV/
.uv/
.python-version

build/
dist/
*.egg-info/
.eggs/

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
typecover/
.import_linter_cache/
.pyright/

.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
._*
.fseventsd

.vscode/
.idea/
*.swp
*.swo

.ipynb_checkpoints/

.env
